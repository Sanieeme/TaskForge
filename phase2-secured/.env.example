# Copy this file to .env and fill in real values for your environment.
# NEVER commit an actual .env file - it is listed in .gitignore for exactly
# that reason. This file only documents what variables exist and what shape
# they take; it contains no real secret values.

# Port the HTTP server listens on
PORT=3001

# development | production
NODE_ENV=development

# How long an idle session stays valid, in milliseconds
SESSION_TTL_MS=1800000

# Path to the SQLite database file
DB_PATH=./taskforge.db

# Comma-separated list of origins allowed to make credentialed CORS requests
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# A real secret in production deployments (e.g. used to sign cookies/tokens).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required (server refuses to start without it) when NODE_ENV=production.
COOKIE_SIGNING_KEY=
